NODE_ENV=development
API_PORT=8080
API_HOST=0.0.0.0
DATABASE_URL=postgresql://school_saas:school_saas_dev@localhost:5432/school_saas?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-development-secret
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Private document storage and scanner integration (configure before uploads)
S3_BUCKET=school-private-documents
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=false
PARENT_INVITE_ENCRYPTION_KEY=replace-with-32-byte-base64-key
DOCUMENT_SCAN_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Parent invitation delivery (worker + HTTPS email provider adapter)
PARENT_EMAIL_PROVIDER_URL=https://email-provider.example/api/send
PARENT_EMAIL_PROVIDER_TOKEN=replace-with-provider-token
PARENT_EMAIL_FROM=no-reply@example.com
PARENT_PORTAL_BASE_URL=https://parent.example.com

# Malware scanner adapter (scanner service must hold the callback HMAC secret)
DOCUMENT_SCANNER_PROVIDER_URL=https://scanner.example/api/scan
DOCUMENT_SCANNER_PROVIDER_TOKEN=replace-with-scanner-service-token
DOCUMENT_SCAN_CALLBACK_URL=https://api.example.com/api/v1/internal/documents

# P41 notification delivery (HTTPS provider adapter; worker rechecks consent/preferences)
NOTIFICATION_EMAIL_PROVIDER_URL=https://email-provider.example/api/send
NOTIFICATION_EMAIL_PROVIDER_TOKEN=replace-with-provider-token
NOTIFICATION_EMAIL_FROM=no-reply@example.com
REPORT_CARD_VERIFY_BASE_URL=https://school.example.com

# P45 canonical email delivery webhook (provider adapter must map signed provider events to canonical schema)
NOTIFICATION_EMAIL_WEBHOOK_PROVIDER=your-configured-provider-id
NOTIFICATION_EMAIL_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# P46 tenant-local email suppression hash key (keep stable; do not rotate without rehash migration)
# Suppression HMAC key rotation: current key writes new records; previous key remains read-only during overlap.
# Keep the legacy variable during migration only; prefer CURRENT_* for new deployments.
NOTIFICATION_SUPPRESSION_HASH_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_SUPPRESSION_HASH_CURRENT_SECRET=
NOTIFICATION_SUPPRESSION_HASH_CURRENT_VERSION=v1
NOTIFICATION_SUPPRESSION_HASH_PREVIOUS_SECRET=
NOTIFICATION_SUPPRESSION_HASH_PREVIOUS_VERSION=

# Optional internal Prometheus scrape endpoint; keep secret and network-restrict /internal/metrics
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters

# P102 platform secrets vault: generate at least 32 random bytes; keep outside source control.
PLATFORM_SECRET_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32

# Required for AES-256-GCM encryption of TOTP seeds. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
MFA_TOTP_ISSUER=School Management SaaS

# Organization member invitation email
# Configure alongside NOTIFICATION_EMAIL_PROVIDER_URL/TOKEN/FROM
ORGANIZATION_ADMIN_INVITATION_BASE_URL=https://admin.example.com
# P437 reminder audit export backpressure limits (active queued + processing jobs)
REMINDER_AUDIT_EXPORT_SCHOOL_QUEUE_CAP=25
REMINDER_AUDIT_EXPORT_REQUESTER_QUEUE_CAP=5
REMINDER_AUDIT_EXPORT_WORKER_INTERVAL_MS=15000
REMINDER_AUDIT_EXPORT_SCHOOL_SCAN_LIMIT=200
REMINDER_AUDIT_EXPORT_WORKER_CONCURRENCY=2
# P440: Worker monitoring heartbeat cadence (health API marks heartbeat stale after 90s).
REMINDER_AUDIT_EXPORT_WORKER_HEARTBEAT_INTERVAL_MS=30000
