FROM node:22-alpine AS build
RUN apk add --no-cache openssl
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY . .
# Until the workspace lockfile is restored, install is intentionally non-frozen.
RUN pnpm install --frozen-lockfile
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build REDIS_URL=redis://:build@127.0.0.1:6379/0
RUN pnpm --filter @school-saas/api prisma:generate
RUN pnpm --filter @school-saas/api build

FROM node:22-alpine AS runtime
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=8080
RUN addgroup -S school && adduser -S school -G school
COPY --from=build --chown=school:school /app /app
WORKDIR /app/backend/api
USER school
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=5s --start-period=45s --retries=5 CMD node -e "fetch('http://127.0.0.1:8080/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server.js"]
