global:
  resolve_timeout: 5m
route:
  receiver: school-operations-webhook
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: school-operations-webhook
    webhook_configs:
      - url: "__ALERT_WEBHOOK_URL__"
        send_resolved: true
