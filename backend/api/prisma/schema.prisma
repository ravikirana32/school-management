generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// P01 foundation schema only. Tenant domain tables and RLS policies are introduced
// after the P02/P04 identity and tenancy design is finalized.
model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}


// P02 identity, membership, authorization and security models.
// Relations are intentionally represented with scalar foreign-key fields in this
// foundation; relational constraints are enforced by the accompanying SQL migration.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum ScopeType {
  PLATFORM
  ORGANIZATION
  SCHOOL
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String?  @unique
  passwordHash    String
  displayName     String
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  isPlatformAdmin Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String   @default("IN")
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  lifecycleStatus OrganizationLifecycleStatus @default(PROVISIONING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  timezone       String   @default("Asia/Kolkata")
  isActive       Boolean  @default(true)
  lifecycleStatus SchoolLifecycleStatus @default(PROVISIONING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model SchoolMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  schoolId       String
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, schoolId])
  @@index([organizationId, schoolId, status])
}

model Role {
  id             String    @id @default(cuid())
  key            String    @unique
  name           String
  scopeType      ScopeType
  isSystem       Boolean   @default(false)
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  rolePermissions RolePermission[]
  assignments UserRoleAssignment[]

  @@index([organizationId, scopeType])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id             String    @id @default(cuid())
  userId         String
  roleId         String
  scopeType      ScopeType
  organizationId String?
  schoolId       String?
  assignedBy     String?
  createdAt      DateTime  @default(now())
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId, scopeType, organizationId, schoolId])
}

model UserSession {
  id                  String        @id @default(cuid())
  userId              String
  refreshTokenHash    String        @unique
  tokenFamilyId       String?
  status              SessionStatus @default(ACTIVE)
  userAgent           String?
  ipAddress           String?
  deviceName          String?
  expiresAt           DateTime
  lastUsedAt          DateTime      @default(now())
  revokedAt           DateTime?
  replacedBySessionId String?
  mfaVerifiedAt       DateTime?
  createdAt           DateTime      @default(now())

  @@index([userId, status])
  @@index([tokenFamilyId, status])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model MfaFactor {
  id            String    @id @default(cuid())
  userId        String
  factorType    String
  secretCipher  String?
  destination  String?
  verifiedAt    DateTime?
  disabledAt    DateTime?
  lastTotpStep  BigInt?
  createdAt     DateTime  @default(now())

  @@index([userId, disabledAt])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  organizationId String?
  schoolId       String?
  action         String
  resourceType   String
  resourceId     String?
  outcome        String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
}


// P03 platform control-plane models
enum TenantLifecycleStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ARCHIVED
}

enum PlatformSettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model PlatformControlSetting {
  id          String                  @id @default(cuid())
  key         String                  @unique
  value       Json
  valueType   PlatformSettingValueType @default(JSON)
  description String?
  isSecret    Boolean                 @default(false)
  updatedBy   String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([updatedAt])
  @@map("PlatformSetting")
}

model TenantLifecycleEvent {
  id             String                @id @default(cuid())
  organizationId String
  fromStatus     TenantLifecycleStatus?
  toStatus       TenantLifecycleStatus
  reason         String
  performedBy    String
  correlationId  String?
  createdAt      DateTime              @default(now())

  @@index([organizationId, createdAt])
  @@index([performedBy, createdAt])
}

model SupportAccessGrant {
  id              String @id @default(cuid())
  organizationId  String
  grantedTo       String
  requestedBy     String?
  approvedBy      String?
  status          SupportAccessGrantStatus @default(ACTIVE)
  approvedAt      DateTime?
  rejectionReason String?
  revokeReason    String?
  reason          String
  ticketReference String?
  startsAt        DateTime
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([organizationId, status, expiresAt, revokedAt])
  @@index([grantedTo, status, expiresAt])
}


// P04 organization and school lifecycle / invitation models
enum OrganizationLifecycleStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ARCHIVED
}

enum SchoolLifecycleStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  CLOSED
}

model OrganizationInvitation {
  id             String   @id @default(cuid())
  organizationId String
  schoolId       String?
  email          String
  roleKey        String
  tokenHash      String   @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId, email, acceptedAt])
  @@index([schoolId, email, acceptedAt])
  @@index([expiresAt])
}


// P05 subscription, invoicing, payments and entitlement models
enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentAttemptStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

model SubscriptionPlan {
  id                String          @id @default(cuid())
  key               String          @unique
  name              String
  description       String?
  currency          String          @default("INR")
  monthlyPrice      Decimal         @db.Decimal(12,2)
  quarterlyPrice    Decimal?        @db.Decimal(12,2)
  yearlyPrice       Decimal?        @db.Decimal(12,2)
  trialDays         Int             @default(0)
  isActive          Boolean         @default(true)
  isPublic          Boolean         @default(true)
  sortOrder         Int             @default(0)
  entitlements      Json
  limits            Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([isActive, isPublic, sortOrder])
}

model OrganizationSubscription {
  id                    String             @id @default(cuid())
  organizationId        String
  planId                String
  status                SubscriptionStatus @default(TRIALING)
  billingInterval       BillingInterval    @default(MONTHLY)
  currency              String             @default("INR")
  unitPrice             Decimal            @db.Decimal(12,2)
  trialStartsAt          DateTime?
  trialEndsAt            DateTime?
  currentPeriodStartsAt  DateTime
  currentPeriodEndsAt    DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  externalCustomerId     String?
  externalSubscriptionId String?
  createdBy              String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([currentPeriodEndsAt, status])
  @@index([externalSubscriptionId])
}

model BillingInvoice {
  id                String        @id @default(cuid())
  organizationId    String
  subscriptionId    String?
  invoiceNumber     String        @unique
  status            InvoiceStatus @default(DRAFT)
  currency          String        @default("INR")
  subtotal          Decimal       @db.Decimal(12,2)
  taxTotal          Decimal       @db.Decimal(12,2) @default(0)
  discountTotal     Decimal       @db.Decimal(12,2) @default(0)
  total             Decimal       @db.Decimal(12,2)
  amountDue         Decimal       @db.Decimal(12,2)
  amountPaid        Decimal       @db.Decimal(12,2) @default(0)
  issuedAt          DateTime?
  dueAt             DateTime?
  paidAt            DateTime?
  billingSnapshot   Json
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([subscriptionId])
}

model BillingInvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Decimal  @db.Decimal(10,2) @default(1)
  unitAmount     Decimal  @db.Decimal(12,2)
  taxRate        Decimal  @db.Decimal(5,2) @default(0)
  lineSubtotal   Decimal  @db.Decimal(12,2)
  lineTax        Decimal  @db.Decimal(12,2) @default(0)
  lineTotal      Decimal  @db.Decimal(12,2)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([invoiceId])
}

model PaymentAttempt {
  id                   String               @id @default(cuid())
  organizationId       String
  invoiceId            String?
  subscriptionId       String?
  provider             String
  providerReference    String?
  idempotencyKey       String
  status               PaymentAttemptStatus @default(CREATED)
  currency             String
  amount               Decimal              @db.Decimal(12,2)
  checkoutUrl          String?
  failureCode          String?
  failureMessage       String?
  processedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([provider, providerReference])
}

model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  provider       String
  providerEventId String
  eventType      String
  payloadHash    String
  processedAt    DateTime?
  processingError String?
  createdAt      DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([processedAt, createdAt])
}

model OrganizationEntitlementOverride {
  id             String   @id @default(cuid())
  organizationId String
  featureKey     String
  enabled        Boolean
  limitValue     Json?
  reason         String
  expiresAt      DateTime?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, featureKey])
  @@index([organizationId, expiresAt])
}


// P06 school profile, academic year, term, calendar and policy configuration
enum AcademicYearStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AcademicTermType {
  TERM
  SEMESTER
  QUARTER
  TRIMESTER
  CUSTOM
}

enum CalendarEventType {
  HOLIDAY
  SCHOOL_EVENT
  EXAM
  PARENT_MEETING
  STAFF_EVENT
  CLOSURE
  OTHER
}

enum CalendarEventAudience {
  ALL
  STUDENTS
  STAFF
  PARENTS
}

model SchoolProfile {
  id                String   @id @default(cuid())
  organizationId    String
  schoolId          String   @unique
  legalName         String?
  displayName       String
  schoolType        String?
  boardKey          String?
  affiliationNumber String?
  addressLine1      String?
  addressLine2      String?
  locality          String?
  city              String?
  state             String?
  postalCode        String?
  countryCode       String   @default("IN")
  phone             String?
  email             String?
  website           String?
  logoObjectKey     String?
  primaryLanguage   String   @default("en")
  timezone          String   @default("Asia/Kolkata")
  currency          String   @default("INR")
  dateFormat        String   @default("DD-MM-YYYY")
  weekStartsOn      Int      @default(1)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId, city])
}

model AcademicYear {
  id             String             @id @default(cuid())
  organizationId String
  schoolId       String
  name           String
  code           String
  startsOn       DateTime           @db.Date
  endsOn         DateTime           @db.Date
  status         AcademicYearStatus @default(DRAFT)
  isCurrent      Boolean            @default(false)
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([schoolId, code])
  @@unique([id, organizationId, schoolId])
  @@index([organizationId, schoolId, status])
  @@index([schoolId, startsOn, endsOn])
}

model AcademicTerm {
  id             String           @id @default(cuid())
  organizationId String
  schoolId       String
  academicYearId String
  name           String
  code           String
  termType       AcademicTermType @default(TERM)
  sequence       Int
  startsOn       DateTime         @db.Date
  endsOn         DateTime         @db.Date
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([academicYearId, code])
  @@unique([academicYearId, sequence])
  @@index([organizationId, schoolId, startsOn])
}

model SchoolCalendar {
  id             String   @id @default(cuid())
  organizationId String
  schoolId       String
  name           String
  academicYearId String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, schoolId])
}

model CalendarEvent {
  id             String               @id @default(cuid())
  organizationId String
  schoolId       String
  calendarId     String
  title          String
  description    String?
  eventType      CalendarEventType
  audience       CalendarEventAudience @default(ALL)
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean              @default(true)
  isInstructionDay Boolean            @default(false)
  location       String?
  createdBy      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, schoolId, startsAt, endsAt])
  @@index([calendarId, eventType])
}

model SchoolDayConfiguration {
  id             String   @id @default(cuid())
  organizationId String
  schoolId       String
  dayOfWeek      Int
  isWorkingDay   Boolean  @default(true)
  opensAt        String?
  closesAt       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, dayOfWeek])
  @@index([organizationId, schoolId])
}

model SchoolPolicy {
  id             String   @id @default(cuid())
  organizationId String
  schoolId       String
  policyKey      String
  value          Json
  version        Int      @default(1)
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, policyKey])
  @@index([organizationId, schoolId])
}


// P07 board and curriculum configuration. Board catalogue metadata is curated
// in the API; tenant-specific selections and curriculum records are persisted here.
enum CurriculumVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CurriculumSubjectType {
  CORE
  ELECTIVE
  LANGUAGE
  VOCATIONAL
  CO_CURRICULAR
}

model SchoolBoardProfile {
  id                   String   @id @default(cuid())
  organizationId       String
  schoolId             String   @unique
  boardKey             String
  boardName            String
  jurisdictionCountry  String   @default("IN")
  jurisdictionRegion   String?
  affiliationNumber    String?
  schoolCategory       String?
  effectiveFrom        DateTime? @db.Date
  effectiveTo          DateTime? @db.Date
  configuration       Json?
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organizationId, boardKey])
}

model GradeLevel {
  id             String   @id @default(cuid())
  organizationId String
  schoolId       String
  code           String
  name           String
  sequence       Int
  stage          String?
  ageMin         Int?
  ageMax         Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, code])
  @@unique([schoolId, sequence])
  @@unique([id, organizationId, schoolId])
  @@index([organizationId, schoolId, isActive])
}

// P29 partial unique indexes for one ACTIVE version per school/year are managed in SQL migration
// 20261117100000_p29_curriculum_active_guard because Prisma schema syntax cannot express partial indexes.
model CurriculumVersion {
  id             String                 @id @default(cuid())
  organizationId String
  schoolId       String
  academicYearId String?
  name           String
  code           String
  boardKey       String
  versionLabel   String?
  status         CurriculumVersionStatus @default(DRAFT)
  effectiveFrom  DateTime?              @db.Date
  effectiveTo    DateTime?              @db.Date
  sourceReference String?
  notes          String?
  createdBy      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([schoolId, code])
  @@unique([id, organizationId, schoolId])
  @@index([organizationId, schoolId, status])
}

enum CurriculumOutcomeReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

model CurriculumOutcome {
  id String @id @default(cuid())
  organizationId String
  schoolId String
  curriculumVersionId String
  curriculumSubjectId String?
  gradeLevelId String
  code String
  title String
  description String?
  competencyDomain String?
  sourceReference String?
  sourceEdition String?
  sourceUrl String?
  provenanceNote String
  reviewStatus CurriculumOutcomeReviewStatus @default(DRAFT)
  reviewedBy String?
  reviewedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, curriculumVersionId, gradeLevelId, code])
  @@unique([id, organizationId, schoolId])
  @@index([organizationId, schoolId, curriculumVersionId, reviewStatus])
}


// P416 — persisted outcome-to-exam alignment records. Composite tenant keys are
// enforced in the migration so mappings cannot cross organization/school scope.
model CurriculumOutcomeAssessmentMapping {
  id String @id @default(cuid())
  organizationId String
  schoolId String
  outcomeId String
  examId String
  createdBy String
  createdAt DateTime @default(now())
  @@unique([schoolId, outcomeId, examId])
  @@index([organizationId, schoolId, outcomeId], map: "CurriculumOutcomeAssessmentMapping_outcome_idx")
  @@index([organizationId, schoolId, examId], map: "CurriculumOutcomeAssessmentMapping_exam_idx")
}


model CurriculumSubject {
  id             String                @id @default(cuid())
  organizationId String
  schoolId       String
  curriculumVersionId String
  gradeLevelId   String
  code           String
  name           String
  subjectType    CurriculumSubjectType @default(CORE)
  languageCode   String?
  isMandatory    Boolean               @default(true)
  weeklyPeriods  Int?
  maxMarks       Decimal?              @db.Decimal(8,2)
  passMarks      Decimal?              @db.Decimal(8,2)
  sequence       Int                   @default(0)
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([curriculumVersionId, gradeLevelId, code])
  @@unique([id, organizationId, schoolId])
  @@index([organizationId, schoolId, gradeLevelId])
}


// P08 student and guardian records. Guardian identity is initially a contact
// record, not a login account; portal access requires a later verified-link flow.
enum StudentStatus {
  APPLICANT
  ACTIVE
  INACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
  ARCHIVED
}

enum GuardianRelationship {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum StudentEnrollmentStatus {
  ENROLLED
  PROMOTED
  TRANSFERRED
  WITHDRAWN
  COMPLETED
}

enum StudentDocumentType {
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  PHOTO
  ADDRESS_PROOF
  IDENTITY_PROOF
  MEDICAL
  PREVIOUS_MARKSHEET
  CONSENT
  OTHER
}

model Student {
  id               String        @id @default(cuid())
  organizationId   String
  schoolId         String
  admissionNumber  String
  firstName        String
  middleName       String?
  lastName         String?
  preferredName    String?
  dateOfBirth      DateTime?     @db.Date
  gender           String?
  bloodGroup       String?
  nationality      String?
  primaryLanguage  String?
  email            String?
  phone            String?
  addressLine1     String?
  addressLine2     String?
  locality         String?
  city             String?
  state            String?
  postalCode       String?
  countryCode      String        @default("IN")
  status           StudentStatus @default(APPLICANT)
  admissionDate    DateTime?     @db.Date
  leavingDate      DateTime?     @db.Date
  notes            String?
  previousSchoolName String?
  previousSchoolBoard String?
  previousSchoolGrade String?
  previousSchoolLeavingDate DateTime? @db.Date
  medicalConditions String?
  allergies String?
  medicationNotes String?
  emergencyMedicalNotes String?
  createdBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  guardians        StudentGuardian[]
  hostelLeaveConsents HostelGuardianConsent[]
  accountLink StudentAccountLink?
  enrollments      StudentEnrollment[]
  pickupContacts   StudentPickupContact[]
  documents        StudentDocument[]
  reportCards      StudentReportCard[]
  statusHistory    StudentStatusHistory[]
  accountingOpeningBalanceRows AccountingOpeningBalanceRow[]

  @@unique([schoolId, admissionNumber])
  @@unique([id, organizationId, schoolId])
  @@index([organizationId, schoolId, status])
  @@index([schoolId, lastName, firstName])
  @@index([schoolId, dateOfBirth])
  accountingHistoricalImportRows AccountingHistoricalImportRow[]
  healthProfile StudentHealthProfile?
  healthEvents StudentHealthEvent[]
  healthAllergies StudentHealthAllergy[]
  healthConditions StudentHealthCondition[]
  healthMedications StudentHealthMedication[]
  healthCases StudentHealthCase[]
  healthIncidents StudentHealthIncident[]
}


model StudentStatusHistory {
  id             String        @id @default(cuid())
  organizationId String
  schoolId       String
  studentId      String
  fromStatus     StudentStatus
  toStatus       StudentStatus
  reason         String?
  effectiveAt    DateTime      @db.Date
  actorUserId    String
  createdAt      DateTime      @default(now())
  student        Student       @relation(fields: [studentId, organizationId, schoolId], references: [id, organizationId, schoolId], onDelete: Cascade)

  @@index([organizationId, schoolId, studentId, createdAt])
  @@index([schoolId, effectiveAt])
}

model Guardian {
  id             String   @id @default(cuid())
  organizationId String
  schoolId       String
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  alternatePhone String?
  occupation     String?
  address        String?
  isActive       Boolean  @default(true)
