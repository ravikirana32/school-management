limit_req_zone $binary_remote_addr zone=school_auth:10m rate=12r/s;
limit_conn_zone $binary_remote_addr zone=school_conn:10m;
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 8080 default_server;
  server_name _;
  return 444;
}
server {
  listen 8443 ssl default_server;
  server_name _;
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  return 444;
}

server {
  listen 8080;
  server_name ${API_HOSTNAME} ${SCHOOL_ADMIN_HOST} ${ORGANIZATION_ADMIN_HOST} ${SUPER_ADMIN_HOST} ${PUBLIC_PORTAL_HOST};
  return 301 https://$host$request_uri;
}

server {
  listen 8443 ssl;
  http2 on;
  server_name ${API_HOSTNAME};
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:TLS:10m;
  ssl_session_timeout 1d;
  server_tokens off;
  client_max_body_size 20m;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  limit_conn school_conn 40;
  location ^~ /api/v1/auth { limit_req zone=school_auth burst=24 nodelay; proxy_pass http://api:8080; include /etc/nginx/snippets/school-proxy.conf; }
  location / { proxy_pass http://api:8080; include /etc/nginx/snippets/school-proxy.conf; }
}

server {
  listen 8443 ssl;
  http2 on;
  server_name ${SCHOOL_ADMIN_HOST};
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  server_tokens off;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  location / { proxy_pass http://web-school-admin:8080; include /etc/nginx/snippets/school-proxy.conf; }
}
