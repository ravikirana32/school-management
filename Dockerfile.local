FROM node:22-alpine
RUN apk add --no-cache openssl libc6-compat
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY . .
# Local developer bootstrap only. Production images remain frozen-lockfile gated.
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @school-saas/api prisma:generate
ENV NODE_ENV=development
EXPOSE 8080 5173 5174 5175 5176 8081 8082 8083 8084
