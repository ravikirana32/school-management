# Copy to .env.prod and replace every example value before deployment.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
POSTGRES_DB=school_saas
POSTGRES_USER=school_saas
SECRETS_DIR=./secrets
TLS_CERT_DIR=./certs
API_HOSTNAME=api.school.example.com
SCHOOL_ADMIN_HOST=school.school.example.com
ORGANIZATION_ADMIN_HOST=org.school.example.com
SUPER_ADMIN_HOST=platform.school.example.com
PUBLIC_PORTAL_HOST=portal.school.example.com
VITE_API_BASE_URL=https://api.school.example.com
CORS_ORIGINS=https://school.school.example.com,https://org.school.example.com,https://platform.school.example.com,https://portal.school.example.com
S3_BUCKET=replace-with-private-bucket-name
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=false
# Use S3 workload identity/instance role where possible. If static keys are required,
# provide S3_ACCESS_KEY_ID_FILE and S3_SECRET_ACCESS_KEY_FILE in the deployment environment.
AGE_RECIPIENT=age1replace-with-generated-recipient
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-org/school-management-saas
IMAGE_TAG=latest
ALERT_WEBHOOK_URL=https://ops.example.com/alertmanager-webhook
PARENT_PORTAL_BASE_URL=https://portal.school.example.com
REPORT_CARD_VERIFY_BASE_URL=https://api.school.example.com

# Organization invitation links (required to send org/school staff invitations)
ORGANIZATION_ADMIN_INVITATION_BASE_URL=https://admin.example.com
