# Local Docker-only development values. Never use these values in production.
POSTGRES_DB=school_saas
POSTGRES_USER=school_saas
POSTGRES_PASSWORD=school_saas_local_only_change_me
DATABASE_URL=postgresql://school_saas:school_saas_local_only_change_me@postgres:5432/school_saas?schema=public
REDIS_URL=redis://redis:6379
# MFA is disabled for local development by default. Set true to enforce it across API-backed apps.
MFA_ENABLED=false
JWT_ACCESS_SECRET=local-only-access-secret-change-this-32-characters-min
JWT_REFRESH_SECRET=local-only-refresh-secret-change-this-32-characters-min
PLATFORM_SECRET_ENCRYPTION_KEY=local-only-platform-encryption-key-change-32chars
PARENT_INVITE_ENCRYPTION_KEY=local-only-parent-invite-key-change-32-characters
METRICS_BEARER_TOKEN=local-only-metrics-token-change-32-characters
CORS_ORIGINS=http://localhost:15173,http://localhost:15174,http://localhost:15175,http://localhost:15176
VITE_API_BASE_URL=http://localhost:18080
VITE_API_V1_BASE_URL=http://localhost:18080/api/v1
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
API_HOST_PORT=18080
SCHOOL_ADMIN_HOST_PORT=15173
ORGANIZATION_ADMIN_HOST_PORT=15174
SUPER_ADMIN_HOST_PORT=15175
PUBLIC_PORTAL_HOST_PORT=15176

# Demo seed is opt-in; use only on a disposable local database.
ALLOW_DEMO_SEED=true
DEMO_SEED_PASSWORD=Demo@School2026!
